CREATE TABLE texas_cogs (
    id BIGSERIAL PRIMARY KEY,
    cog_name TEXT NOT NULL,
    cog_abbreviation TEXT NOT NULL UNIQUE,
    website TEXT,
    region_number INTEGER,
    created_at TIMESTAMP DEFAULT NOW()
);

ALTER TABLE us_cogs
ADD COLUMN IF NOT EXISTS website TEXT;

UPDATE us_cogs uc
SET website = tc.website
FROM texas_cogs tc
WHERE lower(trim(uc.cog_abrvn)) = lower(trim(tc.cog_abbreviation));

